# Create a Python file
cat > calculator.py << 'EOF'
# Simple Calculator

def add(a, b):
    return a + b

def subtract(a, b):
    return a - b

def multiply(a, b):
    return a * b

def divide(a, b):
    return a / b

print(add(2, 3))
EOF

